{
  "entities": {
    "orders": {
      "title": "Orders",
      "description": "Customer pre-orders for adulteration diagnostic test kits",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "description": "Auto-generated unique order identifier"
        },
        "customerName": {
          "type": "string",
          "description": "Customer full name"
        },
        "phone": {
          "type": "string",
          "description": "Customer contact phone number"
        },
        "email": {
          "type": "string",
          "description": "Customer email address"
        },
        "deliveryAddress": {
          "type": "string",
          "description": "Full shipping delivery address including city, state, pincode"
        },
        "items": {
          "type": "array",
          "description": "Ordered test kit products with tier, quantity, and price",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "productName": { "type": "string" },
              "tier": { "type": "string", "enum": ["single-use", "multi-use"] },
              "quantity": { "type": "number" },
              "pricePerItem": { "type": "number" }
            },
            "required": ["productName", "tier", "quantity", "pricePerItem"]
          }
        },
        "orderTotal": {
          "type": "number",
          "description": "Total order amount in Indian Rupees (₹)"
        },
        "orderStatus": {
          "type": "string",
          "enum": ["Pending", "Confirmed", "Fulfilled", "Cancelled"],
          "default": "Pending"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of order submission"
        },
        "notes": {
          "type": "string",
          "default": "",
          "description": "Admin notes for order verification and fulfillment tracking"
        }
      },
      "required": [
        "customerName",
        "phone",
        "email",
        "deliveryAddress",
        "items",
        "orderTotal",
        "orderStatus",
        "createdAt"
      ]
    }
  }
}
