rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Orders collection:
    // Allow customer pre-order submissions and admin management of orders.
    match /orders/{orderId} {
      allow read, write: if true;
    }
    // Messages collection:
    // Allow customer contact inquiries with optional photo attachment and admin review.
    match /messages/{messageId} {
      allow read, write: if true;
    }
  }
}
